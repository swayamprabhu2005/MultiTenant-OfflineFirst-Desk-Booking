# ==============================================================================
# Multi-Tenant Offline-First Desk & Cubicle Booking SaaS Environment Variables
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Node.js / Express backend server
PORT=4000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL used by Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/deskbooking_db?schema=public"

# PostgreSQL credentials for Docker Compose database container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=deskbooking_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (JWT)
# IMPORTANT: Change this to a long, random string in production!
JWT_SECRET="super-secret-jwt-key-for-multi-tenant-desk-booking-saas"

# Expiration duration for user authentication tokens (e.g. 7d, 24h)
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. CORS & SUBDOMAIN ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for cross-origin requests
CORS_ORIGIN="http://localhost:3000,http://acme.localhost:3000,http://techglobe.localhost:3000"

# ------------------------------------------------------------------------------
# 5. FRONTEND WEB CLIENT (Vite PWA)
# ------------------------------------------------------------------------------
# Base API URL used by the web client (defaults to relative /api proxy)
VITE_API_BASE_URL="http://localhost:4000/api"
